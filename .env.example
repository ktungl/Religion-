# Copy to .env.local for local development. Never commit the real file.
# In Vercel: Settings > Environment Variables (server-side, no VITE_ prefix needed).

# Back4App > App Settings > Security & Keys
PARSE_APP_ID=
# Master Key: server only. Never put it in a VITE_ variable or in front-end code.
PARSE_MASTER_KEY=

# AI (server side only). Leave AI_PROVIDER empty to show the reviewed notes instead.
AI_PROVIDER=gemini
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
# Or: AI_PROVIDER=anthropic, ANTHROPIC_API_KEY=..., ANTHROPIC_MODEL=claude-haiku-5-5

# Local testing only
# FT_MEMORY_STORE=1        keep team data in memory instead of Back4App
# FT_TODAY=2027-02-15      pin the server's date (e.g. to demo Ramadan)
